---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroArt from "@/components/HeroArt.astro";
import BookingForm from "@/components/BookingForm.tsx";
import Steps from "@/components/Steps.astro";
---

<Layout>
  <!-- hero -->
  <section class="relative isolate min-h-[86svh] bg-night text-white">
    <HeroArt />
    <div class="relative flex min-h-[86svh] flex-col">
      <div class="mx-auto w-full max-w-[1180px]">
        <Header tone="light" />
      </div>
      <div class="flex flex-1 flex-col justify-end px-5 pb-14 sm:px-10 sm:pb-20">
        <div class="mx-auto w-full max-w-[1100px]">
          <h1 class="display rise max-w-[16ch] text-[19vw] sm:text-[11vw] lg:text-[7.5rem]">
            Stuff gone.
          </h1>
          <p class="lede rise mt-5 max-w-[34ch] text-[1rem] text-white/65 sm:text-[1.15rem]">
            Say what you want out of your life. A drone comes and takes it.
          </p>
          <a href="#book" class="pill pill-light mt-9">Book a pickup</a>
        </div>
      </div>
      <span
        class="pointer-events-none absolute bottom-5 right-5 text-[0.6875rem] font-light tracking-[0.06em] text-white/25 sm:bottom-6 sm:right-10"
      >
        [jelly photo]
      </span>
    </div>
  </section>

  <!-- booking -->
  <section id="book" class="scroll-mt-6 bg-paper px-5 py-16 sm:px-10 sm:py-24">
    <div class="mx-auto max-w-[520px]">
      <BookingForm client:load />
    </div>
  </section>

  <Steps />

  <!-- closer -->
  <section class="bg-mist px-5 py-20 sm:px-10 sm:py-28">
    <div class="mx-auto max-w-[1100px]">
      <h2 class="display text-[12vw] sm:text-[3.4rem]">
        Anything.<br />Anywhere.
      </h2>
      <p class="lede mt-5 max-w-[38ch] text-[0.95rem] text-smoke sm:text-[1.05rem]">
        Furniture, appliances, e-waste, the pile in the garage. If you don't want it,
        we take it.
      </p>
      <a href="#book" class="pill mt-8">Get started</a>
    </div>
  </section>

  <footer class="border-t border-line bg-paper px-5 py-10 sm:px-10">
    <div class="mx-auto flex max-w-[1100px] flex-wrap items-center justify-between gap-6">
      <div>
        <p class="wordmark text-[1.35rem] text-ink">Drone</p>
        <p class="mt-2 text-[0.8125rem] font-light text-smoke">Powered by Jelly Jelly</p>
      </div>
      <nav class="flex flex-wrap items-center gap-x-7 gap-y-3">
        <a class="quiet-link" href="#book">Book a pickup</a>
        <a class="quiet-link" href="/admin">Dispatch</a>
        <a class="quiet-link" href="sms:+12158475657">Text us</a>
      </nav>
    </div>
  </footer>
</Layout>
