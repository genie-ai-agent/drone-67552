---
// Full-bleed black-and-white cover photo behind the hero. Portrait crop swaps in
// on narrow screens so the figure never gets cut off the frame.
---

<div class="pointer-events-none absolute inset-0 overflow-hidden bg-black" aria-hidden="true">
  <picture>
    <source media="(max-width: 700px)" srcset="/cover-portrait.jpg" />
    <img
      src="/cover.jpg"
      alt=""
      width="2000"
      height="1333"
      fetchpriority="high"
      decoding="async"
      class="kenburns h-full w-full object-cover object-[50%_72%] opacity-[0.92] sm:object-[50%_42%]"
    />
  </picture>

  <!-- black grade: two light scrims, enough for the type to read and no more -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, rgba(0,0,0,0.50) 0%, rgba(0,0,0,0.06) 26%, rgba(0,0,0,0.30) 62%, rgba(0,0,0,0.78) 88%, #000000 100%);"
  >
  </div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(90deg, rgba(0,0,0,0.52) 0%, rgba(0,0,0,0.10) 46%, rgba(0,0,0,0) 70%);"
  >
  </div>
</div>
