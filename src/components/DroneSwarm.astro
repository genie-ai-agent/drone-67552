---
// Thin-line quadcopters drifting across a section, each carrying an ETA tag.
// Pure CSS motion, zero client JS. Clipped to the section so nothing scrolls.
interface Props {
  tone?: "light" | "dark";
  /** drones to draw: [top %, size px, seconds, delay s, path] */
  flock?: Array<[number, number, number, number, 1 | 2 | 3]>;
}

const { tone = "light", flock = [] } = Astro.props as Props;

const craft: Array<[number, number, number, number, 1 | 2 | 3]> =
  flock.length > 0
    ? flock
    : [
        [17, 66, 34, 0, 1],
        [42, 44, 46, 7, 2],
        [63, 54, 40, 18, 3],
      ];
---

<div
  class:list={["swarm", tone === "light" ? "swarm-light" : "swarm-dark"]}
  aria-hidden="true"
>
  {
    craft.map(([top, size, dur, delay, path]) => (
      <div
        class={`drone drone-p${path}`}
        style={`top:${top}%; --dur:${dur}s; --delay:-${delay}s; --size:${size}px;`}
      >
        <div class="drone-inner">
          <svg class="craft" viewBox="0 0 66 40" role="presentation">
            <g
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            >
              <path class="rotor" d="M6 13h18" />
              <path class="rotor" d="M42 13h18" />
              <path d="M15 13v4M51 13v4" />
              <path d="M15 17l11 4M51 17l-11 4" />
              <rect x="26" y="20" width="14" height="8" rx="4" />
              <circle cx="33" cy="31" r="2.4" />
              <path d="M33 33.4v2.2" />
            </g>
          </svg>
          <span class="eta">ETA in NYC &middot; 30 min</span>
        </div>
      </div>
    ))
  }
</div>
