---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroCover from "@/components/HeroCover.astro";
import BookingForm from "@/components/BookingForm.tsx";
import Mission from "@/components/Mission.astro";
import Steps from "@/components/Steps.astro";
import Scale from "@/components/Scale.astro";
import Coverage from "@/components/Coverage.astro";
import DroneSwarm from "@/components/DroneSwarm.astro";
---

<Layout>
  <!-- hero -->
  <section class="relative isolate min-h-[92svh] bg-black text-white">
    <HeroCover />
    <DroneSwarm tone="light" />
    <div class="relative z-10 flex min-h-[92svh] flex-col">
      <div class="mx-auto w-full max-w-[1180px]">
        <Header tone="light" />
      </div>
      <div class="flex flex-1 flex-col justify-end px-5 pb-14 sm:px-10 sm:pb-20">
        <div class="mx-auto w-full max-w-[1100px]">
          <p class="eyebrow rise text-white/55">
            Autonomous trash cleaning &middot; Worldwide
          </p>
          <h1 class="display rise mt-5 text-[18vw] sm:text-[10.5vw] lg:text-[7.25rem]">
            Stuff Gone.<br /><span class="text-white/55">Life on.</span>
          </h1>
          <p class="lede rise mt-6 max-w-[36ch] text-[1rem] text-white/70 sm:text-[1.15rem]">
            Say what you want gone. A drone comes and takes it. No crew, no truck,
            no human hands.
          </p>
          <div class="rise mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
            <a href="#book" class="pill pill-light">Book a pickup</a>
            <span class="flex items-center gap-2 text-[0.75rem] font-light tracking-[0.16em] text-white/60 uppercase">
              <span class="blip"></span>ETA in NYC &middot; 30 min
            </span>
          </div>
          <p class="rise mt-10 max-w-[44ch] border-t border-white/20 pt-6 text-[0.8125rem] font-light text-white/60">
            Our mission is to clean all trash without human labor.
            <a class="whitespace-nowrap text-white/80 underline decoration-white/30 underline-offset-4 hover:decoration-white" href="#mission">Read it</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <Mission />

  <!-- booking -->
  <section id="book" class="scroll-mt-6 bg-paper px-5 py-16 sm:px-10 sm:py-24">
    <div class="mx-auto max-w-[520px]">
      <BookingForm client:load />
    </div>
  </section>

  <Steps />
  <Scale />
  <Coverage />

  <!-- closer -->
  <section class="relative isolate overflow-hidden border-t border-line bg-paper px-5 py-20 sm:px-10 sm:py-28">
    <DroneSwarm tone="dark" labels={false} flock={[[10, 46, 42, 3, 2], [82, 38, 52, 22, 3]]} />
    <div class="relative z-10 mx-auto max-w-[1100px]">
      <h2 class="display text-[12vw] sm:text-[3.4rem]">
        Any trash.<br />Anywhere.<br /><span class="text-smoke">Nobody carrying it.</span>
      </h2>
      <p class="lede mt-6 max-w-[38ch] text-[0.95rem] text-smoke sm:text-[1.05rem]">
        Furniture, appliances, e-waste, the bags by the door, the pile in the garage.
        If you don't want it, the fleet takes it.
      </p>
      <a href="#book" class="pill mt-9">Get started</a>
    </div>
  </section>

  <footer class="border-t border-line bg-mist px-5 py-12 sm:px-10">
    <div class="mx-auto flex max-w-[1100px] flex-wrap items-start justify-between gap-8">
      <div>
        <p class="wordmark text-[1.35rem] text-black">Drone</p>
        <p class="mt-2 text-[0.8125rem] font-light text-smoke">Stuff Gone. Life on.</p>
        <p class="lede mt-4 max-w-[30ch] text-[0.8125rem] text-quiet">
          Our mission is to clean all trash without human labor.
        </p>
      </div>
      <nav class="flex flex-wrap items-center gap-x-7 gap-y-3">
        <a class="quiet-link" href="#book">Book a pickup</a>
        <a class="quiet-link" href="#mission">Mission</a>
        <a class="quiet-link" href="#cities">Cities</a>
        <a class="quiet-link" href="/admin">Dispatch</a>
        <a class="quiet-link" href="sms:+12158475657">Text us</a>
      </nav>
    </div>
  </footer>
</Layout>
