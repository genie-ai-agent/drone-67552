---
// Dark hero backdrop. The framed plate on the right is the slot for the jelly
// photo; the line-art drone is the placeholder motif until the image lands.
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- soft light falling from top right -->
  <div
    class="absolute -right-1/4 -top-1/3 h-[80vh] w-[80vh] rounded-full opacity-[0.14]"
    style="background: radial-gradient(closest-side, #ffffff, transparent 70%);"
  >
  </div>

  <!-- fine dot field -->
  <div
    class="absolute inset-0 opacity-[0.07]"
    style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 12px 12px;"
  >
  </div>

  <!-- drone -->
  <svg
    class="drift absolute right-[6%] top-[26%] w-[58%] max-w-[380px] opacity-[0.5] sm:right-[8%] sm:top-[22%] sm:w-[38%] lg:w-[30%]"
    viewBox="0 0 400 240"
    fill="none"
    stroke="#ffffff"
    stroke-width="1.25"
  >
    <path d="M60 54h280" />
    <path d="M110 54v22" />
    <path d="M290 54v22" />
    <ellipse cx="60" cy="54" rx="52" ry="7" />
    <ellipse cx="340" cy="54" rx="52" ry="7" />
    <rect x="150" y="62" width="100" height="34" rx="6" />
    <circle cx="200" cy="79" r="6" />
    <path d="M200 96v56" stroke-dasharray="4 8" />
    <rect x="164" y="152" width="72" height="56" rx="4" />
    <path d="M164 172h72M200 152v56" stroke-opacity="0.45" />
  </svg>
</div>
