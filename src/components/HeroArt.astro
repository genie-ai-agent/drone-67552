---
// Monochrome hero plate. The framed panel is the slot for the jelly photo
// thumbnail; the line-art drone is the placeholder motif until it lands.
---

<figure class="m-0">
  <div
    class="relative aspect-[4/3] max-h-[440px] w-full overflow-hidden border border-hairline bg-[#0b0b0a] sm:aspect-[16/10] lg:aspect-[4/3]"
  >
    <!-- halftone dot field -->
    <div
      class="absolute inset-0 opacity-[0.16]"
      style="background-image: radial-gradient(#fafaf8 1px, transparent 1px); background-size: 9px 9px;"
    >
    </div>
    <!-- horizon -->
    <div class="absolute left-0 right-0 top-[62%] h-px bg-hairline"></div>

    <svg
      class="drift absolute left-1/2 top-[16%] w-[62%] max-w-[420px] -translate-x-1/2"
      viewBox="0 0 400 240"
      fill="none"
      stroke="#fafaf8"
      stroke-width="2"
      aria-hidden="true"
    >
      <!-- rotor arms -->
      <path d="M60 54h280" />
      <path d="M110 54v22" /><path d="M290 54v22" />
      <!-- rotors -->
      <ellipse cx="60" cy="54" rx="52" ry="7" />
      <ellipse cx="340" cy="54" rx="52" ry="7" />
      <!-- body -->
      <rect x="150" y="62" width="100" height="34" />
      <circle cx="200" cy="79" r="7" />
      <!-- tether -->
      <path d="M200 96v56" stroke-dasharray="5 7" />
      <!-- crate -->
      <rect x="162" y="152" width="76" height="58" />
      <path d="M162 172h76M200 152v58" stroke-opacity="0.5" />
    </svg>

    <span class="label absolute bottom-3 left-4">[jelly photo]</span>
    <span class="label absolute bottom-3 right-4">fig. 01</span>
  </div>
</figure>
