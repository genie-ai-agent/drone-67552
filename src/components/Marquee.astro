---
const items = [
  "old couch",
  "broken tv",
  "moving boxes",
  "that chair",
  "a mattress",
  "christmas tree",
  "ex's hoodie",
  "desk",
  "bike frame",
  "mystery bin",
];
const loop = [...items, ...items];
---

<div class="overflow-hidden border-y border-hairline py-3">
  <div class="marquee-track">
    {
      loop.map((item) => (
        <span class="label whitespace-nowrap px-5">
          {item} <span class="text-paper">/ gone</span>
        </span>
      ))
    }
  </div>
</div>
