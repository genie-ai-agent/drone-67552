---
import { Mic, Send, Wind } from "lucide-react";

const steps = [
  {
    icon: Mic,
    t: "Say it",
    d: "Hit the mic and name the trash. Plain words, no forms.",
  },
  {
    icon: Send,
    t: "Book it",
    d: "One tap. It goes straight to the fleet, nobody to schedule.",
  },
  {
    icon: Wind,
    t: "It's gone",
    d: "Hauled, sorted, recycled. The video of the job trains the next one.",
  },
];
---

<section class="border-y border-line bg-paper px-5 py-16 sm:px-10 sm:py-20">
  <div class="mx-auto grid max-w-[1100px] gap-10 sm:grid-cols-3 sm:gap-8">
    {
      steps.map(({ icon: Icon, t, d }) => (
        <div>
          <Icon size={22} strokeWidth={1.25} />
          <h3 class="mt-5 text-[1rem] font-normal tracking-[-0.02em]">{t}</h3>
          <p class="lede mt-2 max-w-[28ch] text-[0.875rem] text-smoke">{d}</p>
        </div>
      ))
    }
  </div>
  <p class="mx-auto mt-14 max-w-[1100px] text-[0.75rem] font-light text-quiet">
    Same day where available. No photos, no lists, no human labor.
  </p>
</section>
