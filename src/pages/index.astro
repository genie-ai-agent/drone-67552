---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroArt from "@/components/HeroArt.astro";
import Marquee from "@/components/Marquee.astro";
import BookingForm from "@/components/BookingForm.tsx";

const steps = [
  { n: "01", t: "Say it", d: "Hit the mic and name the thing. Couch, crib, whole garage." },
  { n: "02", t: "Book it", d: "One tap. Your number and the job land with a pilot." },
  { n: "03", t: "It's gone", d: "A drone shows up, lifts it, leaves. You don't touch it." },
];
---

<Layout>
  <Header />

  <main class="px-5 sm:px-10">
    <section class="grid items-end gap-8 pt-10 sm:pt-14 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
      <div>
        <p class="label">Pickup / anywhere / on demand</p>
        <h1 class="display mt-4 text-[22vw] sm:text-[15vw] lg:text-[8.5rem]">
          Stuff<br />gone.
        </h1>
        <p class="mt-6 max-w-[34ch] text-[1rem] leading-relaxed text-smoke sm:text-[1.1rem]">
          Tell us what you want out of your life. A drone takes it.
        </p>
      </div>
      <div class="lg:pb-2">
        <HeroArt />
      </div>
    </section>

    <section class="mx-auto mt-12 max-w-[560px] border-t border-hairline pt-2 sm:mt-16">
      <BookingForm client:load />
    </section>
  </main>

  <div class="mt-16">
    <Marquee />
  </div>

  <section class="px-5 py-14 sm:px-10">
    <div class="grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        steps.map((s) => (
          <div>
            <p class="label">{s.n}</p>
            <h3 class="display mt-3 text-[1.75rem] sm:text-[2rem]">{s.t}</h3>
            <p class="mt-3 max-w-[30ch] text-[0.92rem] leading-relaxed text-smoke">{s.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <footer class="border-t border-hairline px-5 py-8 sm:px-10">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="display text-[1.75rem] leading-none">Drone</p>
        <p class="label mt-2">Stuff gone.</p>
      </div>
      <div class="text-right">
        <p class="label">A Jelly Jelly thing</p>
        <a class="label mt-2 block underline underline-offset-4" href="/admin">Dispatch log</a>
      </div>
    </div>
  </footer>
</Layout>
